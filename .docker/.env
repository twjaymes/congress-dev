# App / stage
STAGE=dev

# API ports
PORT=9090
FASTAPI_PORT=9091

# Database (shared)
DB_HOST=localhost:5432
DB_USER=parser
DB_PASS=parser
DB_TABLE=us_code

# Postgres container
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser
POSTGRES_DB=us_code

# Frontend (React)
REACT_APP_API_URL=http://localhost:9001
REACT_APP_API_V2_URL=http://localhost:9001
CHOKIDAR_USEPOLLING=true

# Next.js / Hillstack
DATABASE_URL=postgresql://parser:parser@congress_postgres:5432/us_code
NEXT_PUBLIC_APP_URL=http://localhost:3001

# PgAdmin
PGADMIN_DEFAULT_EMAIL=user@example.com
PGADMIN_DEFAULT_PASSWORD=your_admin_password
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False